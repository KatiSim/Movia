        MediaContent(id = "ia:the-first-anime-katsudo-shashin-c.-1907", title = "The First Anime ' Katsudō Shashin' C. 1907", type = ContentType.MOVIE, year = 1917, rating = 0.0, genres = setOf(CatalogCategory.ANIME.label), country = "—", quality = "360p", durationMinutes = 1, isNew = false, popularity = 1, ageRating = 0, originalTitle = "The First Anime ' Katsudō Shashin' C. 1907", director = "unknow", synopsis = "The film consists of a series of cartoon images on fifty frames of a celluloid strip and lasts three seconds at sixteen frames per second. It depicts a young boy in a sailor suit who writes the kanji characters \"活動写真\" (katsudou shashin, or \"moving picture\"), then turns towards the viewer, removes his hat, and offers a salute. The fragment was discovered in 2005, having been purchased with a private collection in Kyoto. The film was likely created between 1905 and 1911. If so, the film may be the oldest known piece of animation from Japan.", category = CatalogCategory.ANIME, sourceUrl = "https://archive.org/details/the-first-anime-katsudo-shashin-c.-1907", playbackUrl = "https://archive.org/download/the-first-anime-katsudo-shashin-c.-1907/The First Anime - 'Katsudō Shashin' C.1907.mp4", posterUrl = "https://archive.org/download/the-first-anime-katsudo-shashin-c.-1907/the-first-anime-katsudo-shashin-c.-1907.thumbs/The First Anime - 'Katsudō Shashin' C.1907_000005.jpg", licenseName = "Public Domain", licenseUrl = "https://creativecommons.org/publicdomain/mark/1.0/"),
        MediaContent(id = "ia:eigasenshuu-02-05-tora_chan_the_abandoned_kitten-1947-dvd_202607", title = "Tora-chan, the Abandoned Kitten (1947)", type = ContentType.MOVIE, year = 1947, rating = 0.0, genres = setOf(CatalogCategory.ANIME.label), country = "—", quality = "480p", durationMinutes = 21, isNew = false, popularity = 1, ageRating = 0, originalTitle = "Tora-chan, the Abandoned Kitten (1947)", director = "Kenzō Masaoka", synopsis = "This short film is about a family of cats who find an abandoned kitten named Tora-Chan and take him in to their home. But one of the siblings, Mika, becomes jealous about the attention the new cat gets from her mother and runs away from home. As a result, Tora-chan feels responsible and goes on an adventurous journey to find her, facing danger (including a dog and a hen protecting her chicks) to bring her home safely. Through his courage and kindness, he eventually convinces Mika to return, and they reconcile. By the end, he is fully accepted as part of the family. While the movie looks like a cute animal fable on the surface, it holds a much deeper meaning. When it was made in 1947, Japan was recovering from the devastation of World War II. Thousands of real children had lost their parents and were left homeless, begging for food at train stations and markets. The film was intentionally used to encourage Japanese families to open their hearts, overcome biases, and adopt these \"lost generation\" war orphans. Kenzō Masaoka used beautiful music and expressive animation to teach a lesson about kindness, acceptance, and rebuilding society together.", category = CatalogCategory.ANIME, sourceUrl = "https://archive.org/details/eigasenshuu-02-05-tora_chan_the_abandoned_kitten-1947-dvd_202607", playbackUrl = "https://archive.org/download/eigasenshuu-02-05-tora_chan_the_abandoned_kitten-1947-dvd_202607/eigasenshuu-02-05-tora_chan_the_abandoned_kitten-1947-dvd.mp4", posterUrl = "https://archive.org/download/eigasenshuu-02-05-tora_chan_the_a