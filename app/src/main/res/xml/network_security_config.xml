<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- По умолчанию cleartext запрещён -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Разрешаем cleartext только для локального шлюза -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>

    <!-- The original Zona media API returns HTTP video URLs from this CDN.
         Other public destinations retain the HTTPS default. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">vibio.tv</domain>
        <domain includeSubdomains="false">5.61.56.18</domain>
        <domain includeSubdomains="true">hdrezka-fly.net</domain>
    </domain-config>

    <!-- Разрешаем cleartext для балансеров, если они работают по HTTP -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">hdrezka.ag</domain>
        <domain includeSubdomains="true">rezka.ag</domain>
        <domain includeSubdomains="true">kodik.info</domain>
        <domain includeSubdomains="true">kodik.biz</domain>
        <domain includeSubdomains="true">collaps.org</domain>
        <domain includeSubdomains="true">alloha.tv</domain>
    </domain-config>
</network-security-config>
