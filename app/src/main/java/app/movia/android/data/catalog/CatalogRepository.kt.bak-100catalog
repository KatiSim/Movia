        MediaContent(id = "ia:1_20251118_20251118_0908", title = "CIRCUS_8 — Rielaborazione di HomeArt di Pietro Grossi / Reworking of Pietro Grossi’s HomeArt", type = ContentType.MOVIE, year = 2008, rating = 0.0, genres = setOf(CatalogCategory.INTERACTIVE.label), country = "—", quality = "720p HD", durationMinutes = 5, isNew = false, popularity = 46, ageRating = 0, originalTitle = "CIRCUS_8 — Rielaborazione di HomeArt di Pietro Grossi / Reworking of Pietro Grossi’s HomeArt", director = "Sergio Maltagliati", synopsis = "CIRCUS_8 documents an audiovisual project by Sergio Maltagliati, initiated in 1997 and developed from the graphic software of Pietro Grossi’s HomeArt series. Maltagliati works directly on Grossi’s original code, creating new visual structures and combining them with an original generative soundtrack produced with autom@tedMusic . The DVD presents an artwork that integrates algorithmic graphics and generative music , revealing in real time the relationship between signs, colours, pseudo-random variations, and evolving sound structures. It is the first audiovisual publication that brings together Grossi’s visual and sound research within a coherent, contemporary reinterpretation: a tribute to the Italian pioneer of computer music, telematic networks, generative art, and open-source processes in artistic practice. Released by the Quantum Bit netlabel, the DVD was produced in a limited edition with a distinctive vacuum-sealed packaging, making it a unique art object. CIRCUS_8 has been featured in: Politecnico di Milano — GA2009 , XII Generative Art Conference Sguardi Sonori / Infinite Spaces - Festival of media and time based art, Museo della Civiltà Romana (2010-2011) Art Laboratory B", category = CatalogCategory.INTERACTIVE, sourceUrl = "https://archive.org/details/1_20251118_20251118_0908", playbackUrl = "https://archive.org/download/1_20251118_20251118_0908/1.mp4", posterUrl = "https://archive.org/download/1_20251118_20251118_0908/1_20251118_20251118_0908.thumbs/1_000057.jpg", licenseName = "CC BY-SA", licenseUrl = "https://creativecommons.org/licenses/by-sa/4.0/"),
