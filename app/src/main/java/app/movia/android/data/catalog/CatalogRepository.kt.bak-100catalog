        MediaContent(id = "ia:a-page-of-madness-1926_202507", title = "A Page Of Madness (1926)", type = ContentType.MOVIE, year = 1926, rating = 0.0, genres = setOf(CatalogCategory.DRAMAS_ASIAN.label), country = "—", quality = "480p", durationMinutes = 71, isNew = false, popularity = 59, ageRating = 0, originalTitle = "A Page Of Madness (1926)", director = "Teinosuke Kinugasa, Yasunari Kawabata, Minoru Inuzuka, Banko Sawada", synopsis = "I've been researching newly public domain films from 1929 and earlier, so I'm uploading the best possible copies that I can find. This Japanese experimental horror film was thought to be lost for 45 years before being found in a storehouse in 1971. It takes place in a mental institution and shows the delirium of the many patients, as well as how it seems to be affecting the elderly janitor who works there. The film was a collaboration with many writers but one of those writers, Yasunari Kawabata, was eventually awarded the Nobel prize for literature.", category = CatalogCategory.DRAMAS_ASIAN, sourceUrl = "https://archive.org/details/a-page-of-madness-1926_202507", playbackUrl = "https://archive.org/download/a-page-of-madness-1926_202507/A Page of Madness (1926).mp4", posterUrl = "https://archive.org/download/a-page-of-madness-1926_202507/a-page-of-madness-1926_202507.thumbs/A Page of Madness (1926)_000117.jpg", licenseName = "Public Domain", licenseUrl = "https://creativecommons.org/publicdomain/mark/1.0/"),
