#!/data/data/com.termux/files/usr/bin/bash
set -u
exec 2>&1
export PYTHONUNBUFFERED=1
export SSL_CERT_FILE="$PREFIX/etc/tls/cert.pem"
export MOVIA_ENRICH_WORKERS="${MOVIA_ENRICH_WORKERS:-1}"
export MOVIA_BACKGROUND_BULK=1
export MOVIA_BACKGROUND_ALLOW_METERED="${MOVIA_BACKGROUND_ALLOW_METERED:-0}"
export MOVIA_BACKGROUND_REQUIRE_CHARGING="${MOVIA_BACKGROUND_REQUIRE_CHARGING:-1}"
export MOVIA_BACKGROUND_MONTHLY_GIB="${MOVIA_BACKGROUND_MONTHLY_GIB:-4}"
export MOVIA_BACKGROUND_DAILY_MIB="${MOVIA_BACKGROUND_DAILY_MIB:-128}"
MOVIA_ENRICH_BATCH_LIMIT="${MOVIA_ENRICH_BATCH_LIMIT:-40}"
MOVIA_ENRICH_INTERVAL_SECONDS="${MOVIA_ENRICH_INTERVAL_SECONDS:-21600}"
MOVIA_BLOCKED_RECHECK_SECONDS="${MOVIA_BLOCKED_RECHECK_SECONDS:-1800}"
cd "$HOME/projects/media-parser"

child_pid=""
stop_children() {
  if [ -n "$child_pid" ]; then
    kill -TERM "$child_pid" 2>/dev/null || true
    wait "$child_pid" 2>/dev/null || true
    child_pid=""
  fi
  exit 0
}
trap stop_children TERM INT HUP

while true; do
  sleep_seconds="$MOVIA_BLOCKED_RECHECK_SECONDS"
  if "$PREFIX/bin/python3" -u background_network_budget.py; then
    "$PREFIX/bin/python3" -u content_filler.py --limit "$MOVIA_ENRICH_BATCH_LIMIT" --resume &
    child_pid=$!
    wait "$child_pid" 2>/dev/null || true
    child_pid=""
    sleep_seconds="$MOVIA_ENRICH_INTERVAL_SECONDS"
  fi

  sleep "$sleep_seconds" &
  child_pid=$!
  wait "$child_pid" 2>/dev/null || true
  child_pid=""
done
