import { execFile as execFileCb, spawn } from "node:child_process";
import { randomUUID } from "node:crypto";
import { mkdir, stat, writeFile } from "node:fs/promises";
import { join } from "node:path";
import { promisify } from "node:util";

import type { McpServer } from "@modelcontextprotocol/sdk/server/mcp.js";
import * as z from "zod/v4";

import { HOME } from "./config.js";

const execFile = promisify(execFileCb);
const ADB = "adb";
const ANDROID_DATA_DIR = join(HOME, ".local/share/termux-mcp-android");
const ANDROID_SCREENSHOT_DIR = join(ANDROID_DATA_DIR, "screenshots");
const MAX_TEXT_OUTPUT = 4 * 1024 * 1024;
const MAX_SCREENSHOT_BYTES = 32 * 1024 * 1024;

function textResult(data: unknown) {
  return {
    content: [
      {
        type: "text" as const,
        text: typeof data === "string" ? data : JSON.stringify(data, null, 2)
      }
    ]
  };
}

function errorResult(error: unknown) {
  return {
    isError: true,
    content: [
      {
        type: "text" as const,
        text: error instanceof Error ? error.message : String(error)
      }
    ]
  };
}

function validateSerial(serial?: string): string | undefined {
  if (!serial) return undefined;
  if (!/^[A-Za-z0-9._:-]{1,200}$/.test(serial)) throw new Error("Invalid ADB serial");
  return serial;
}

function withSerial(serial: string | undefined, args: string[]): string[] {
  const value = validateSerial(serial);
  return value ? ["-s", value, ...args] : args;
}

async function runAdbText(args: string[], timeoutMs = 15_000, maxBuffer = MAX_TEXT_OUTPUT): Promise<{ stdout: string; stderr: string }> {
  try {
    const result = await execFile(ADB, args, {
      timeout: timeoutMs,
      maxBuffer,
      encoding: "utf8"
    });
    return {
      stdout: result.stdout,
      stderr: result.stderr
    };
  } catch (error: any) {
    const stderr = typeof error?.stderr === "string" ? error.stderr.trim() : "";
    const stdout = typeof error?.stdout === "string" ? error.stdout.trim() : "";
    const detail = stderr || stdout || error?.message || String(error);
    throw new Error(`ADB command failed: ${String(detail).slice(0, 4000)}`);
  }
}

async function runAdbBinary(args: string[], timeoutMs = 20_000, maxBytes = MAX_SCREENSHOT_BYTES): Promise<Buffer> {
  return new Promise((resolve, reject) => {
    const child = spawn(ADB, args, { stdio: ["ignore", "pipe", "pipe"] });
    const stdout: Buffer[] = [];
    const stderr: Buffer[] = [];
    let stdoutBytes = 0;
    let settled = false;
    const timer = setTimeout(() => {
      child.kill("SIGTERM");
      if (!settled) {
        settled = true;
        reject(new Error("ADB binary command timed out"));
      }
    }, timeoutMs);
    timer.unref();

    child.stdout?.on("data", (chunk: Buffer) => {
      stdoutBytes += chunk.length;
      if (stdoutBytes > maxBytes) {
        child.kill("SIGTERM");
        if (!settled) {
          settled = true;
          clearTimeout(timer);
          reject(new Error(`ADB binary output exceeded ${maxBytes} bytes`));
        }
        return;
      }
      stdout.push(Buffer.from(chunk));
    });
    child.stderr?.on("data", (chunk: Buffer) => {
      if (stderr.reduce((sum, item) => sum + item.length, 0) < 256 * 1024) stderr.push(Buffer.from(chunk));
    });
    child.once("error", error => {
      if (settled) return;
      settled = true;
      clearTimeout(timer);
      reject(error);
    });
    child.once("close", code => {
      if (settled) return;
      settled = true;
      clearTimeout(timer);
      if (code !== 0) {
        reject(new Error(`ADB command exited ${code}: ${Buffer.concat(stderr).toString("utf8").slice(0, 4000)}`));
        return;
      }
      resolve(Buffer.concat(stdout));
    });
  });
}

function parseDevices(output: string) {
  return output.split(/\r?\n/)
    .slice(1)
    .map(line => line.trim())
    .filter(Boolean)
    .map(line => {
      const fields = line.split(/\s+/);
      const serial = fields.shift() || "";
      const state = fields.shift() || "unknown";
      const properties: Record<string, string> = {};
      for (const field of fields) {
        const index = field.indexOf(":");
        if (index > 0) properties[field.slice(0, index)] = field.slice(index + 1);
      }
      return { serial, state, properties };
    });
}

async function getDevices() {
  const { stdout } = await runAdbText(["devices", "-l"], 10_000);
  return parseDevices(stdout);
}

async function requireDevice(serial?: string): Promise<string> {
  const requested = validateSerial(serial);
  const devices = await getDevices();
  if (requested) {
    const match = devices.find(device => device.serial === requested);
    if (!match) throw new Error(`ADB device not found: ${requested}`);
    if (match.state !== "device") throw new Error(`ADB device ${requested} is not authorized/online (state=${match.state})`);
    return requested;
  }
  const connected = devices.filter(device => device.state === "device");
  if (connected.length === 1) return connected[0].serial;
  if (connected.length === 0) {
    const unavailable = devices.map(device => `${device.serial}:${device.state}`).join(", ");
    throw new Error(`No authorized ADB device is connected${unavailable ? ` (${unavailable})` : ""}. Wireless debugging pairing is required.`);
  }
  throw new Error(`Multiple ADB devices are connected (${connected.map(device => device.serial).join(", ")}); provide serial.`);
}

function shellQuote(value: string): string {
  return `'${value.replaceAll("'", `'\\''`)}'`;
}

const serialSchema = z.string().regex(/^[A-Za-z0-9._:-]{1,200}$/).optional();

export function registerAndroidTools(server: McpServer): void {
  server.registerTool(
    "android_status",
    {
      title: "Android ADB status",
      description: "Read ADB client version, connected/authorized devices, and discoverable wireless-debugging mDNS services.",
      inputSchema: {},
      annotations: { readOnlyHint: true, destructiveHint: false, idempotentHint: true, openWorldHint: false }
    },
    async () => {
      try {
        const [{ stdout: version }, devices, mdns] = await Promise.all([
          runAdbText(["version"], 10_000),
          getDevices(),
          runAdbText(["mdns", "services"], 10_000).then(result => result.stdout.trim()).catch(() => "")
        ]);
        return textResult({
          adbInstalled: true,
          adbVersion: version.trim(),
          devices,
          connectedDevices: devices.filter(device => device.state === "device").length,
          wirelessDebuggingServices: mdns ? mdns.split(/\r?\n/).filter(Boolean) : []
        });
      } catch (error) {
        return errorResult(error);
      }
    }
  );

  server.registerTool(
    "android_screenshot",
    {
      title: "Android screenshot",
      description: "Capture the current Android display over an already-authorized ADB connection and save a private PNG in Termux.",
      inputSchema: { serial: serialSchema },
      annotations: { readOnlyHint: true, destructiveHint: false, idempotentHint: false, openWorldHint: false }
    },
    async ({ serial }) => {
      try {
        const device = await requireDevice(serial);
        await mkdir(ANDROID_SCREENSHOT_DIR, { recursive: true, mode: 0o700 });
        const data = await runAdbBinary(withSerial(device, ["exec-out", "screencap", "-p"]));
        if (data.length < 8 || data.subarray(1, 4).toString("ascii") !== "PNG") throw new Error("ADB screencap did not return a valid PNG");
        const path = join(ANDROID_SCREENSHOT_DIR, `${new Date().toISOString().replace(/[:.]/g, "-")}-${randomUUID().slice(0, 8)}.png`);
        await writeFile(path, data, { mode: 0o600 });
        const info = await stat(path);
        return textResult({ serial: device, path, bytes: info.size });
      } catch (error) {
        return errorResult(error);
      }
    }
  );

  server.registerTool(
    "android_dump_ui",
    {
      title: "Android UI hierarchy",
      description: "Dump the current native Android UIAutomator hierarchy over an already-authorized ADB connection. The temporary device-side XML is removed after reading.",
      inputSchema: { serial: serialSchema, compressed: z.boolean().default(true) },
      annotations: { readOnlyHint: true, destructiveHint: false, idempotentHint: false, openWorldHint: false }
    },
    async ({ serial, compressed }) => {
      const remote = "/data/local/tmp/termux_mcp_ui.xml";
      try {
        const device = await requireDevice(serial);
        const dumpArgs = ["shell", "uiautomator", "dump"];
        if (compressed) dumpArgs.push("--compressed");
        dumpArgs.push(remote);
        await runAdbText(withSerial(device, dumpArgs), 20_000);
        const { stdout } = await runAdbText(withSerial(device, ["exec-out", "cat", remote]), 20_000, MAX_TEXT_OUTPUT);
        return textResult({ serial: device, xml: stdout, bytes: Buffer.byteLength(stdout) });
      } catch (error) {
        return errorResult(error);
      } finally {
        const devices = await getDevices().catch(() => []);
        const device = validateSerial(serial) || devices.find(item => item.state === "device")?.serial;
        if (device) await runAdbText(withSerial(device, ["shell", "rm", "-f", remote]), 5_000).catch(() => {});
      }
    }
  );

  server.registerTool(
    "android_current_activity",
    {
      title: "Android current activity",
      description: "Read the currently resumed Android activity over ADB.",
      inputSchema: { serial: serialSchema },
      annotations: { readOnlyHint: true, destructiveHint: false, idempotentHint: true, openWorldHint: false }
    },
    async ({ serial }) => {
      try {
        const device = await requireDevice(serial);
        const { stdout } = await runAdbText(withSerial(device, ["shell", "dumpsys", "activity", "activities"]), 15_000, MAX_TEXT_OUTPUT);
        const match = stdout.match(/mResumedActivity:\s+ActivityRecord\{[^}]*\s([^\s}]+)\s+t\d+/) || stdout.match(/topResumedActivity=.*?\s([^\s}]+)\s/);
        return textResult({ serial: device, activity: match?.[1] || null });
      } catch (error) {
        return errorResult(error);
      }
    }
  );

  server.registerTool(
    "android_tap",
    {
      title: "Tap Android screen",
      description: "Tap screen coordinates over an authorized ADB connection. Requires ANDROID_UI confirmation from an explicit user instruction.",
      inputSchema: {
        confirm: z.literal("ANDROID_UI"),
        x: z.number().int().min(0).max(20_000),
        y: z.number().int().min(0).max(20_000),
        serial: serialSchema
      },
      annotations: { readOnlyHint: false, destructiveHint: true, idempotentHint: false, openWorldHint: false }
    },
    async ({ x, y, serial }) => {
      try {
        const device = await requireDevice(serial);
        await runAdbText(withSerial(device, ["shell", "input", "tap", String(x), String(y)]), 10_000);
        return textResult({ serial: device, tapped: { x, y } });
      } catch (error) { return errorResult(error); }
    }
  );

  server.registerTool(
    "android_swipe",
    {
      title: "Swipe Android screen",
      description: "Swipe between screen coordinates over ADB. Requires ANDROID_UI confirmation from an explicit user instruction.",
      inputSchema: {
        confirm: z.literal("ANDROID_UI"),
        x1: z.number().int().min(0).max(20_000),
        y1: z.number().int().min(0).max(20_000),
        x2: z.number().int().min(0).max(20_000),
        y2: z.number().int().min(0).max(20_000),
        durationMs: z.number().int().min(1).max(10_000).default(300),
        serial: serialSchema
      },
      annotations: { readOnlyHint: false, destructiveHint: true, idempotentHint: false, openWorldHint: false }
    },
    async ({ x1, y1, x2, y2, durationMs, serial }) => {
      try {
        const device = await requireDevice(serial);
        await runAdbText(withSerial(device, ["shell", "input", "swipe", String(x1), String(y1), String(x2), String(y2), String(durationMs)]), 15_000);
        return textResult({ serial: device, swiped: { x1, y1, x2, y2, durationMs } });
      } catch (error) { return errorResult(error); }
    }
  );

  server.registerTool(
    "android_input_text",
    {
      title: "Type Android text",
      description: "Type text through Android's ADB input command. Unicode behavior depends on Android/IME. Requires ANDROID_UI confirmation.",
      inputSchema: {
        confirm: z.literal("ANDROID_UI"),
        text: z.string().max(20_000),
        serial: serialSchema
      },
      annotations: { readOnlyHint: false, destructiveHint: true, idempotentHint: false, openWorldHint: false }
    },
    async ({ text, serial }) => {
      try {
        if (/[\u0000\r\n]/.test(text)) throw new Error("android_input_text does not accept NUL/newlines; use android_press_key for Enter");
        const device = await requireDevice(serial);
        const encoded = text.replaceAll("%", "\\%").replaceAll(" ", "%s");
        const command = `input text ${shellQuote(encoded)}`;
        await runAdbText(withSerial(device, ["shell", command]), 20_000);
        return textResult({ serial: device, typedCharacters: [...text].length });
      } catch (error) { return errorResult(error); }
    }
  );

  server.registerTool(
    "android_press_key",
    {
      title: "Press Android key",
      description: "Send an Android keyevent over ADB. Requires ANDROID_UI confirmation.",
      inputSchema: {
        confirm: z.literal("ANDROID_UI"),
        key: z.union([z.number().int().min(0).max(500), z.string().regex(/^KEYCODE_[A-Z0-9_]+$/)]),
        serial: serialSchema
      },
      annotations: { readOnlyHint: false, destructiveHint: true, idempotentHint: false, openWorldHint: false }
    },
    async ({ key, serial }) => {
      try {
        const device = await requireDevice(serial);
        await runAdbText(withSerial(device, ["shell", "input", "keyevent", String(key)]), 10_000);
        return textResult({ serial: device, key });
      } catch (error) { return errorResult(error); }
    }
  );

  server.registerTool(
    "android_launch_app",
    {
      title: "Launch Android app",
      description: "Launch an installed app by package name using the standard launcher intent. Requires ANDROID_UI confirmation.",
      inputSchema: {
        confirm: z.literal("ANDROID_UI"),
        packageName: z.string().regex(/^[A-Za-z0-9._]{1,255}$/),
        serial: serialSchema
      },
      annotations: { readOnlyHint: false, destructiveHint: true, idempotentHint: false, openWorldHint: false }
    },
    async ({ packageName, serial }) => {
      try {
        const device = await requireDevice(serial);
        const { stdout } = await runAdbText(withSerial(device, ["shell", "monkey", "-p", packageName, "-c", "android.intent.category.LAUNCHER", "1"]), 20_000);
        return textResult({ serial: device, packageName, launched: !/No activities found/i.test(stdout), output: stdout.trim().slice(0, 2000) });
      } catch (error) { return errorResult(error); }
    }
  );
}
