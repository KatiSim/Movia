# Movia 0.9.32 example only. Do not commit real values.
TMDB_API_KEY=

# Phone-local control plane / P2P (non-secret defaults)
MOVIA_CONTROL_PLANE_URL=http://127.0.0.1:8888
MOVIA_TORRSERVER_URL=http://127.0.0.1:18090

# Optional cloud deployment policy
MOVIA_CLOUD_MODE=0
MOVIA_ENABLE_P2P=1

# Background catalog enrichment budget
MOVIA_BACKGROUND_MONTHLY_GIB=4.2
MOVIA_BACKGROUND_DAILY_MIB=0
MOVIA_WIFI_ENRICH_WORKERS=6
MOVIA_MOBILE_ENRICH_WORKERS=1
MOVIA_MOBILE_ENRICH_LIMIT=20

# Termux MCP — set the secret privately
TERMUX_MCP_HOST=127.0.0.1
TERMUX_MCP_PORT=8940
TERMUX_MCP_SECRET=
TERMUX_MCP_ROOTS=
TERMUX_MCP_JOB_ROOT=
